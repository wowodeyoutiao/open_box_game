--- !u!114 &8799545253346545969
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1927649244104262352}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.5803922, g: 0.427451, b: 0.33333334, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 78007512fbe5a014cbbce65c67722440, type: 3}
    m_FontSize: 20
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 1
    m_MaxSize: 49
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "<b><size=24>\u300A\u8FD9\u5C9B\u6709\u5267\u672C\u300B\u5185\u6D4B\u516C\u544A</size></b>\r\n\r\n\u4EB2\u7231\u7684\u5C9B\u4E3B\uFF1A\r\n\u300A\u8FD9\u5C9B\u6709\u5267\u672C\u300B\u5220\u6863\u5185\u6D4B\u5C06\u4E8E6\u670820\u65E5\u6B63\u5F0F\u5F00\u542F\uFF01\n\n\u670D\u52A1\u5668\u5F00\u653E\u65F6\u95F4\uFF1A\n1\u670D\uFF1A<b>6\u670820\u65E511:00</b>\n2\u670D\uFF1A<b>6\u670821\u65E511:00</b>\r\n\n\u5F00\u7BB1\u6302\u673A\uFF0C\u8F7B\u677E\u795E\u88C5\uFF01\u5E7F\u88A4\u7684\u5C9B\u5C7F\uFF0C\u65E0\u5C3D\u7684\u8D22\u5B9D\uFF0C\u4F20\u4E16\u7684\u88C5\u5907\u90FD\u9759\u5F85\u60A8\u7684\u53D1\u73B0\u3002\r\n\r\n<color=#ff0000ff>\u3010\u5185\u6D4B\u798F\u5229\u3011</color>\n<b>1.
    \u6BCF\u65E5\u767B\u5F55\u9886\u5143\u5B9D</b>\r\n\u6BCF\u65E5\u7B7E\u5230\u5373\u9001\_20,000\u5143\u5B9D\uFF0C\u7545\u73A9\u5168\u5C9B\u65E0\u538B\u529B\uFF01(\u4EF7\u503C\uFFE51400\uFF0C\u7545\u4E70\u5C9B\u4E0A\u7269\u8D44)\r\n<b>2.
    \u767B\u5C9B\u8C6A\u534E\u793C\u5305</b>\r\n\u8FDB\u5165\u6E38\u620F\u5373\u5F97\uFF1A\r\n\u767D\u94F6\u94A5\u5319
    \xD750\uFF08\u4EF7\u503C\uFFE51000\uFF0C\u6700\u9AD8\u89E3\u9501\u6A59\u8272\u4F19\u4F34\uFF09\r\n\u7D2B\u8272\u5BA0\u7269\u86CB
    \xD750\uFF08\u4EF7\u503C\uFFE51000\uFF0C\u6700\u9AD8\u5408\u6210\u5C0A\u54C1\u7EA2\u8272\u5BA0\u7269\uFF09\r\n<b>3.
    \u8D44\u6E90\u652F\u63F4</b>\r\n\u6D4B\u8BD5\u671F\u95F4\u9053\u5177/\u8D44\u6E90\u4E0D\u8DB3\uFF1F\u6DFB\u52A0\u5BA2\u670D\u5FAE\u4FE1\uFF0C\u514D\u8D39\u7533\u9886\u6240\u9700\u7269\u8D44\uFF01\r\n<b>4.
    \u6D4B\u8BD5\u53CD\u9988</b>\r\n\u6D4B\u8BD5\u671F\u95F4\u901A\u8FC7\u5BA2\u670D\u53CD\u9988\u60A8\u6E38\u620F\u8FC7\u7A0B\u4E2D\u9047\u5230\u7684\u5EFA\u8BAE\u548C\u95EE\u9898\uFF0C\u6211\u4EEC\u5C06\u4F1A\u6839\u636E\u53CD\u9988\u5185\u5BB9\u5728\u516C\u6D4B\u5F00\u59CB\u540E\u989D\u5916\u8D60\u9001\u795E\u79D8\u5927\u5956\u3002\r\n\r\n<color=#ff0000ff>\u3010\u53C2\u4E0E\u65B9\u5F0F\u3011</color>\n\u6DFB\u52A0\u5BA2\u670D\u5FAE\u4FE1\uFF1A[zdyjb2025]
    \u5373\u53EF\u83B7\u5F97\u6E38\u620F\u94FE\u63A5\u6216\u7533\u9886\u7269\u8D44\u3002\r\n\r\n<color=#ff0000ff>\u3010\u6CE8\u610F\u4E8B\u9879\u3011</color>\n\u6D4B\u8BD5\u540D\u989D\u6709\u9650\uFF0C\u6EE1\u989D\u540E\u5C06\u5173\u95ED\u52A0\u5165\u901A\u9053\uFF0C\u8BF7\u5C3D\u5FEB\u53C2\u4E0E\uFF1B\r\n\u6E38\u620F\u6570\u636E\u5C06\u5728\u516C\u6D4B\u65F6\u6E05\u7A7A\uFF0C\u4F46\u5185\u6D4B\u53CD\u9988\u8005\u5C06\u83B7\u516C\u6D4B\u9650\u5B9A\u79F0\u53F7\uFF01\r\n\r\n<color=#ff0000ff>\u3010\u6E38\u620F\u8BF4\u660E\u3011</color>\n\u300A\u8FD9\u5C9B\u6709\u5267\u672C\u300B\u662F\u4E00\u6B3E\u4EE5Q\u7248\u5361\u901A\u98CE\u683C\u4E3A\u4E3B\uFF0C\u4EE5\u5F00\u7BB1\u6536\u96C6\u4E3A\u6838\u5FC3\u723D\u70B9\uFF0C\u878D\u5408\u4E86\u653E\u7F6E\u6302\u673A\u3001\u89D2\u8272\u626E\u6F14\u3001\u52A8\u4F5C\u5192\u9669\u7684\u5F00\u7BB1\u5C0F\u6E38\u620F\u3002\u5305\u542B\u4E86\u591A\u4EBA\u5728\u7EBF\u5B9E\u65F6PK\uFF0C\u516C\u4F1A\u6218\uFF0C\u4E16\u754CBOSS\u7B49\u591A\u79CD\u73A9\u6CD5\u3002\u5728\u8F7B\u677E\u517B\u6210\u4E2D\u4F53\u9A8C\u591A\u5143\u6D41\u6D3E\u6218\u6597\u7684\u4E50\u8DA3\u3002"
