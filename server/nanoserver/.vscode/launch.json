{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}",
            "env": {},
            "args": []
        },
        {
            "name": "远程调试 - 连接到运行中的程序",
            "type": "go",
            "debugAdapter": "dlv-dap",
            "request": "attach",
            "mode": "remote",
            "port": 12345,
            "host": "47.117.128.230", // 替换为您的远程服务器IP
            "showLog": true,
            "logOutput": "rpc",
            // "stopOnEntry": true,
            "substitutePath": [
                {
                    "from": "${workspaceFolder}", // 本地源码目录
                    "to": "/mnt/c/Users/EDY/workspace/nanoserver/" // 远程服务器上编译时的源码路径（需要根据实际情况修改）
                }
            ]
        },
    ]
}